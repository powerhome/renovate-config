{
  "packageRules": [
    {
      "groupName": "Percona dependencies",
      "description": "Group all Percona-related dependencies together",
      "labels": [
        "dependencies",
        "percona-upgrades"
      ],
      "matchPackageNames": [
        "percona/percona-distribution-postgresql",
        "percona/percona-pgbackrest",
        "percona/percona-pgbouncer",
        "percona/percona-postgresql-operator",
        "pg-db",
        "pg-operator"
      ],
      "allowedVersions": "/^(1\\.25\\.0\\-1|2\\.8\\.2|2\\.8\\.2\\-ppg13\\.23\\-postgres\\-gis3\\.3\\.8|2\\.8\\.2\\-ppg14\\.20\\-postgres\\-gis3\\.3\\.8|2\\.8\\.2\\-ppg15\\.15\\-postgres\\-gis3\\.3\\.8|2\\.8\\.2\\-ppg16\\.11\\-postgres\\-gis3\\.3\\.8|2\\.8\\.2\\-ppg17\\.7\\-postgres\\-gis3\\.3\\.8|2\\.8\\.2\\-ppg18\\.1\\-postgres\\-gis3\\.5\\.4|2\\.57\\.0\\-1|13\\.23\\-2|14\\.20\\-2|15\\.15\\-2|16\\.11\\-2|17\\.7\\-2|18\\.1\\-3)$/",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/^\\d+\\.\\d+\\.\\d+$/",
      "versioning": "semver",
      "allowedVersions": "/^(2\\.8\\.2)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg13(?:[.-]\\d+)?-postgres-gis/",
      "versioning": "semver",
      "allowedVersions": "/^(2\\.8\\.2\\-ppg13\\.23\\-postgres\\-gis3\\.3\\.8)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg14(?:[.-]\\d+)?-postgres-gis/",
      "versioning": "semver",
      "allowedVersions": "/^(2\\.8\\.2\\-ppg14\\.20\\-postgres\\-gis3\\.3\\.8)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg15(?:[.-]\\d+)?-postgres-gis/",
      "versioning": "semver",
      "allowedVersions": "/^(2\\.8\\.2\\-ppg15\\.15\\-postgres\\-gis3\\.3\\.8)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg16(?:[.-]\\d+)?-postgres-gis/",
      "versioning": "semver",
      "allowedVersions": "/^(2\\.8\\.2\\-ppg16\\.11\\-postgres\\-gis3\\.3\\.8)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg17(?:[.-]\\d+)?-postgres-gis/",
      "versioning": "semver",
      "allowedVersions": "/^(2\\.8\\.2\\-ppg17\\.7\\-postgres\\-gis3\\.3\\.8)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg18(?:[.-]\\d+)?-postgres-gis/",
      "versioning": "semver",
      "allowedVersions": "/^(2\\.8\\.2\\-ppg18\\.1\\-postgres\\-gis3\\.5\\.4)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-distribution-postgresql"
      ],
      "matchCurrentVersion": "/^13\\./",
      "allowedVersions": "/^(13\\.23\\-2)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-distribution-postgresql"
      ],
      "matchCurrentVersion": "/^14\\./",
      "allowedVersions": "/^(14\\.20\\-2)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-distribution-postgresql"
      ],
      "matchCurrentVersion": "/^15\\./",
      "allowedVersions": "/^(15\\.15\\-2)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-distribution-postgresql"
      ],
      "matchCurrentVersion": "/^16\\./",
      "allowedVersions": "/^(16\\.11\\-2)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-distribution-postgresql"
      ],
      "matchCurrentVersion": "/^17\\./",
      "allowedVersions": "/^(17\\.7\\-2)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-distribution-postgresql"
      ],
      "matchCurrentVersion": "/^18\\./",
      "allowedVersions": "/^(18\\.1\\-3)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-pgbouncer"
      ],
      "allowedVersions": "/^(1\\.25\\.0\\-1)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-pgbackrest"
      ],
      "allowedVersions": "/^(2\\.57\\.0\\-1)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/pmm-client"
      ],
      "matchFileNames": [
        "**/postgresql.yaml.erb",
        "**/percona_pgcluster.yaml.erb"
      ],
      "matchCurrentVersion": "/^2\\./",
      "versioning": "semver",
      "allowedVersions": "/^(2\\.44\\.1\\-1)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/pmm-client"
      ],
      "matchFileNames": [
        "**/postgresql.yaml.erb",
        "**/percona_pgcluster.yaml.erb"
      ],
      "matchCurrentVersion": "/^3\\./",
      "versioning": "semver",
      "allowedVersions": "/^(3\\.5\\.0)$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/-pgbackrest[\\d.-]*$/",
      "replacementName": "percona/percona-pgbackrest",
      "replacementVersion": "2.57.0-1"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/-pgbouncer[\\d.-]*$/",
      "replacementName": "percona/percona-pgbouncer",
      "replacementVersion": "1.25.0-1"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg13(?:[.-]\\d+)*-postgres$/",
      "replacementName": "percona/percona-distribution-postgresql",
      "replacementVersion": "13.23-2"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg14(?:[.-]\\d+)*-postgres$/",
      "replacementName": "percona/percona-distribution-postgresql",
      "replacementVersion": "14.20-2"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg15(?:[.-]\\d+)*-postgres$/",
      "replacementName": "percona/percona-distribution-postgresql",
      "replacementVersion": "15.15-2"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg16(?:[.-]\\d+)*-postgres$/",
      "replacementName": "percona/percona-distribution-postgresql",
      "replacementVersion": "16.11-2"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg17(?:[.-]\\d+)*-postgres$/",
      "replacementName": "percona/percona-distribution-postgresql",
      "replacementVersion": "17.7-2"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchCurrentVersion": "/\\bppg18(?:[.-]\\d+)*-postgres$/",
      "replacementName": "percona/percona-distribution-postgresql",
      "replacementVersion": "18.1-3"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "percona/percona-postgresql-operator"
      ],
      "matchUpdateTypes": [
        "replacement"
      ],
      "branchTopic": "percona-dependencies"
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "pg-db"
      ],
      "allowedVersions": "/^(2\\.8\\.2)$/"
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "pg-operator"
      ],
      "allowedVersions": "/^(2\\.8\\.2)$/"
    }
  ]
