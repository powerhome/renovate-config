{
    "description": "Exempt Powerhome repositories only on GitHub-native datasources whose source URL comes from the actual lookup endpoint.",
    "matchDatasources": [
        "github-tags",
        "github-releases",
        "github-digest"
    ],
    "matchPackageNames": [
        "/^powerhome\\/[A-Za-z0-9_][A-Za-z0-9_.-]*$/"
    ],
    "minimumReleaseAge": null,
    "matchSourceUrls": [
        "https://github.com/powerhome/**"
    ]
}
